# Copy to .env and fill in. Never commit .env.
PAYLOAD_SECRET=change-me-to-a-long-random-string
DATABASE_URI=file:./brandbook.db        # SQLite (default). For Postgres: postgres://user:pass@host:5432/db
CORS_ORIGINS=http://localhost:4321       # comma-separated origins allowed to read the API (your build host)

# Only used by the seed script:
SEED_ADMIN_EMAIL=admin@fokusnordic.se
SEED_ADMIN_PASSWORD=change-me
