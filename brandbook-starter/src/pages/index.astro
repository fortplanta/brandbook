---
import BrandbookLayout from '../layouts/BrandbookLayout.astro';
import SideNav from '../components/SideNav.astro';
import Cover from '../components/sections/Cover.astro';
import Placeholder from '../components/sections/Placeholder.astro';
import CategoryHero from '../components/CategoryHero.astro';
import SectionHero from '../components/SectionHero.astro';
// I. Varumärkesplattform
import Introduktion from '../components/sections/Introduktion.astro';
import VisionMission from '../components/sections/VisionMission.astro';
import Karnvarden from '../components/sections/Karnvarden.astro';
import Manifest from '../components/sections/Manifest.astro';
import Platform from '../components/sections/Platform.astro';
import Personlighet from '../components/sections/Personlighet.astro';
import Tone from '../components/sections/Tone.astro';
import BrandStory from '../components/sections/BrandStory.astro';
import Malgrupper from '../components/sections/Malgrupper.astro';
// II. Visuell identitet
import LogotypesSection from '../components/sections/LogotypesSection.astro';
import Colors from '../components/sections/Colors.astro';
import Typography from '../components/sections/Typography.astro';
import GrafiskaElement from '../components/sections/GrafiskaElement.astro';
import Imagery from '../components/sections/Imagery.astro';
import LayoutGrid from '../components/sections/LayoutGrid.astro';
import Ikonografi from '../components/sections/Ikonografi.astro';
import Illustration from '../components/sections/Illustration.astro';
// III. Rörligt & ljud
import Motion from '../components/sections/Motion.astro';
import Video from '../components/sections/Video.astro';
import LjudId from '../components/sections/LjudId.astro';
// IV. Tillämpning
import Digitalt from '../components/sections/Digitalt.astro';
import Print from '../components/sections/Print.astro';
import CoBranding from '../components/sections/CoBranding.astro';
import Merch from '../components/sections/Merch.astro';
import Exempel from '../components/sections/Exempel.astro';
import MediaSection from '../components/sections/MediaSection.astro';
// V. Resurser & governance
import Downloads from '../components/sections/Downloads.astro';
import Kontakt from '../components/sections/Kontakt.astro';
import Versionshistorik from '../components/sections/Versionshistorik.astro';
import { resolveStructure } from '../content/categories';
import { loadProfile } from '../lib/loadProfile';

// Content source: local file, or the CMS when PAYLOAD_URL is set. Same shape.
const profile = await loadProfile();

// Sections backed by client content. Sections not listed here have no content
// model yet — they're filled once their component is built (they render the
// placeholder until then).
// Applications (from the CMS drop zone) by kind → the Tillämpning sections.
// Signage/environment has no section of its own; it joins "Exempel i verkligheten".
const apps = (...kinds: string[]) => (profile.applications ?? []).filter((a) => kinds.includes(a.kind));
const isVideo = (src?: string) => !!src && /\.(mp4|webm)(\?|$)/i.test(src);
// A logo animation (a video filed under Logotyp) becomes the logo section's hero.
const logoVideo = profile.logos?.find((l) => isVideo(l.image));
const logoStill = profile.logos?.find((l) => l.image && !isVideo(l.image));

const has: Record<string, boolean> = {
  positionering: (profile.platform?.length ?? 0) > 0,
  tonalitet: (profile.tone?.principles?.length ?? 0) > 0,
  logos: profile.logos?.length > 0,
  colors: profile.colors?.length > 0 || (profile.colorInUse?.length ?? 0) > 0,
  typography: profile.typography?.length > 0,
  imagery: (profile.imagery?.images?.length ?? 0) > 0,
  motion: profile.motion?.length > 0,
  downloads: profile.downloads?.length > 0,
  'grafiska-element': (profile.graphics?.length ?? 0) > 0,
  digitalt: apps('digital').length > 0,
  print: apps('print').length > 0,
  merch: apps('merch').length > 0,
  exempel: apps('environment', 'example').length > 0,
  versionshistorik: (profile.changelog?.length ?? 0) > 0,
};

// Short brand line for generated posters (colour guide): the first sentence of
// the first platform block, else the tagline, else the client name.
const posterText = (profile.platform?.[0]?.body.match(/^[^.!?]+[.!?]/)?.[0] ?? profile.tagline ?? profile.client).trim();

// Apply the client's visibility settings to the template structure.
const structure = resolveStructure((id) => Boolean(has[id]), profile.visibility, profile.hideEmpty);

// Sidebar model — progressive disclosure: pages in page order, each flagged
// `primary` (always visible) or not (behind "+ N till"). A section with ≤ 4
// visible pages shows them all; if a client hid primaries, the next pages in
// order are promoted so at least 3 show. `inNav: false` pages stay on the page
// but only get a hidden marker in the sidebar (so scroll tracking still maps
// them to their category). Locked categories/pages stay as greyed teasers.
const nav = structure.map((cat) => {
  const listed = cat.sections.filter((s) => s.inNav !== false);
  const primary = new Set(listed.length <= 4 ? listed.map((s) => s.id) : listed.filter((s) => s.primary).map((s) => s.id));
  for (const s of listed) { if (primary.size >= 3) break; primary.add(s.id); }
  return {
    id: cat.id,
    label: cat.label,
    locked: cat.locked,
    items: cat.sections.map((s) => ({
      id: s.id, label: s.label, locked: s.locked,
      primary: primary.has(s.id), hidden: s.inNav === false,
      // no content yet → greyed "Saknas" in the sidebar; opens the why-dialog
      empty: !s.filled && !s.locked,
    })),
  };
});
const historyHref = structure.some((c) => c.sections.some((s) => s.id === 'versionshistorik' && !s.locked)) && (profile.changelog?.length ?? 0) > 0
  ? '#versionshistorik' : undefined;

// The page: each category with something to show opens with its chapter hero,
// then its sections in order (locked ones only tease in the nav).
const chapters = structure
  .filter((cat) => !cat.locked)
  .map((cat) => ({ cat, sections: cat.sections.filter((s) => !s.locked) }))
  .filter((c) => c.sections.length > 0);
---

<BrandbookLayout title={`${profile.client} — Brandbook`} description={profile.tagline} accent={profile.accent}>
  <SideNav
    slot="nav"
    client={profile.client}
    updated={profile.updated}
    nav={nav}
    downloadAllHref={profile.downloadAllHref}
    historyHref={historyHref}
  />

  <Cover client={profile.client} tagline={profile.tagline} note={profile.cover?.note} background={profile.cover?.background} />

  {chapters.map(({ cat, sections }) => (
    <div class="catwrap" data-catwrap={cat.id}>
      <CategoryHero category={cat} colors={profile.colors} downloads={profile.downloads} changelog={profile.changelog} />
      {/* "You are here": a zero-height sticky anchor right after the chapter hero.
          Its pill rides up with the page, sticks top-left while this category's
          pages scroll by, and is pushed out when the wrapper ends — where the
          next category's pill takes over. Pure CSS (position: sticky). */}
      <div class="catstick" aria-hidden="true">
        <a class="catpill" href={`#kapitel-${cat.id}`} tabindex="-1"><span class="catpill__num">{cat.roman}</span>{cat.label}</a>
      </div>
      {sections.map(({ id, filled }) => (
      <>
        {/* I. Varumärkesplattform */}
        {id === 'introduktion' && <Introduktion />}
        {id === 'vision-mission' && <VisionMission />}
        {id === 'karnvarden' && <Karnvarden />}
        {id === 'manifest' && <Manifest />}
        {id === 'positionering' && (filled ? <Platform platform={profile.platform} /> : <Placeholder id={id} />)}
        {id === 'personlighet' && <Personlighet />}
        {id === 'tonalitet' && (filled && profile.tone ? <Tone tone={profile.tone} /> : <Placeholder id={id} />)}
        {id === 'brand-story' && <BrandStory />}
        {id === 'malgrupper' && <Malgrupper />}
        {/* II. Visuell identitet */}
        {id === 'logos' && (filled ? (
        <LogotypesSection logos={profile.logos}>
          <SectionHero slot="hero" id="logos" media={logoVideo ? { src: logoVideo.image } : undefined}>
            <div class="shero-logo" slot="fallback"><img src={logoStill?.image ?? profile.logos[0].image} alt="" /></div>
          </SectionHero>
        </LogotypesSection>
      ) : <Placeholder id={id} />)}
        {id === 'colors' && (filled ? <Colors colors={profile.colors} typography={profile.typography} guide={profile.colorGuide} colorInUse={profile.colorInUse} client={profile.client} text={posterText} /> : <Placeholder id={id} />)}
        {id === 'typography' && (filled ? <Typography typography={profile.typography} /> : <Placeholder id={id} />)}
        {id === 'grafiska-element' && (filled ? <MediaSection id={id} items={profile.graphics ?? []} /> : <GrafiskaElement />)}
        {id === 'imagery' && (filled ? <Imagery note={profile.imagery.note} images={profile.imagery.images} /> : <Placeholder id={id} />)}
        {id === 'layout-grid' && <LayoutGrid />}
        {id === 'ikonografi' && <Ikonografi />}
        {id === 'illustration' && <Illustration />}
        {/* III. Rörligt & ljud */}
        {id === 'motion' && (filled ? <Motion motion={profile.motion} /> : <Placeholder id={id} />)}
        {id === 'video' && <Video />}
        {id === 'ljud-id' && <LjudId />}
        {/* IV. Tillämpning */}
        {id === 'digitalt' && (filled ? <MediaSection id={id} items={apps('digital')} /> : <Digitalt />)}
        {id === 'print' && (filled ? <MediaSection id={id} items={apps('print')} /> : <Print />)}
        {id === 'co-branding' && <CoBranding />}
        {id === 'merch' && (filled ? <MediaSection id={id} items={apps('merch')} /> : <Merch />)}
        {id === 'exempel' && (filled ? <MediaSection id={id} items={apps('environment', 'example')} /> : <Exempel />)}
        {/* V. Resurser & governance */}
        {id === 'downloads' && (filled ? <Downloads downloads={profile.downloads} downloadAllHref={profile.downloadAllHref} /> : <Placeholder id={id} />)}
        {id === 'kontakt' && <Kontakt />}
        {id === 'versionshistorik' && (filled ? <Versionshistorik changelog={profile.changelog ?? []} /> : <Placeholder id={id} />)}
      </>
      ))}
    </div>
  ))}
</BrandbookLayout>
