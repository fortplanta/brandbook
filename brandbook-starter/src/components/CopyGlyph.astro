---
/* Copy / copied icon pair — the check replaces the copy icon while the parent
   has .is-copied (see .copy-glyph in global.css). */
---
<span class="copy-glyph" aria-hidden="true">
  <svg class="copy-glyph__copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/></svg>
  <svg class="copy-glyph__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5 10 17 19 7"/></svg>
</span>
