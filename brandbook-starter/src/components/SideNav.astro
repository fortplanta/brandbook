---
/* Sidebar. Progressive disclosure: an open category lists only its primary
   pages; the rest (in page order) are behind "+ N till" and appear in place
   (enhance.ts also opens it when you scroll into one of them). Footer tools are
   a single quiet row of icon buttons. */
import { t } from '../lib/strings';

interface NavItem { id: string; label: string; locked?: boolean; primary?: boolean; hidden?: boolean; }
interface NavCat { id: string; label: string; locked?: boolean; items: NavItem[]; }
interface Props {
  client: string;
  updated?: string;
  nav: NavCat[];
  downloadAllHref?: string;
  historyHref?: string;
}
const { client, updated, nav, downloadAllHref, historyHref } = Astro.props;
const initial = client.trim().charAt(0).toUpperCase();
---

<nav class="nav" data-nav data-open="false" aria-label="Brandbook">
  <div class="nav__id">
    <span class="nav__mark" aria-hidden="true">{initial}</span>
    <span class="nav__idtext">
      <a href="#top" class="nav__client">{client}</a>
      {updated && <span class="nav__updated">{t.meta.updated} {updated}</span>}
    </span>
  </div>

  <button class="nav__search" type="button" data-search-open aria-label={t.search.open}>
    <svg class="nav__search-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
    <span class="nav__search-label">{t.search.open}</span>
    <kbd class="nav__search-kbd" aria-hidden="true">⌘K</kbd>
  </button>

  <button class="nav__toggle" data-nav-toggle type="button" aria-expanded="false">{t.actions.menu}</button>

  <div class="nav__panel">
    <div class="nav__scroll">
      {nav.map((cat) => (
        <div class:list={['cat', { 'cat--locked': cat.locked }]} data-cat={cat.id} data-open={cat.locked ? undefined : 'true'}>
          {cat.locked ? (
            <div class="cat__head" aria-disabled="true" title={t.locked.aria}>
              <span class="cat__dot" aria-hidden="true"></span>
              <span class="cat__label">{cat.label}</span>
              <span class="cat__hint">{t.locked.hint}</span>
              <svg class="cat__lock" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
            </div>
          ) : (
            <button class="cat__head" type="button" data-cat-toggle aria-expanded="true">
              <span class="cat__dot" aria-hidden="true"></span>
              <span class="cat__label">{cat.label}</span>
              <svg class="cat__chev" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </button>
          )}

          {!cat.locked && (
            <div class="cat__list">
              <div class="cat__inner">
                <ul>
                  {cat.items.map((it) => (
                    <li class:list={[!it.primary && 'nav__item--more']} hidden={it.hidden}>
                      {it.locked ? (
                        <span class="nav__link nav__link--locked" aria-disabled="true" title={t.locked.aria}>
                          <span class="nav__linklabel">{it.label}</span>
                        </span>
                      ) : (
                        <a class="nav__link" href={`#${it.id}`} data-nav-link={it.id}>
                          <span class="nav__linklabel">{it.label}</span>
                        </a>
                      )}
                    </li>
                  ))}
                </ul>
                {(() => {
                  const more = cat.items.filter((it) => !it.primary && !it.hidden).length;
                  return more > 0 && (
                    <button class="cat__more" type="button" data-cat-more aria-expanded="false" data-more-label={`+ ${more} till`}>
                      <span data-cat-more-label>+ {more} till</span>
                      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                  );
                })()}
              </div>
            </div>
          )}
        </div>
      ))}
    </div>

    <div class="nav__foot">
      <div class="nav__foot-inner">
        <div class="nav__tools">
          {downloadAllHref && (
            <a class="navtool" href={downloadAllHref} download aria-label={t.actions.downloadAll} title={t.actions.downloadAll}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"/><path d="m7 10 5 5 5-5"/><path d="M5 20h14"/></svg>
            </a>
          )}
          <button class="navtool" type="button" data-print aria-label={t.actions.downloadPdf} title={t.actions.downloadPdf}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/></svg>
          </button>
          {historyHref && (
            <a class="navtool" href={historyHref} aria-label="Versionshistorik" title="Versionshistorik">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v5h5"/><path d="M3.05 13A9 9 0 1 0 6 5.3L3 8"/><path d="M12 7v5l3 2"/></svg>
            </a>
          )}
          <button class="navtool nav__sound" type="button" data-sound-toggle aria-pressed="true" aria-label="Ljudeffekter" title="Ljudeffekter">
            <svg class="nav__sound-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M18.5 5.5a9 9 0 0 1 0 13"/></svg>
            <svg class="nav__sound-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z"/><path d="m22 9-6 6M16 9l6 6"/></svg>
          </button>
          <a class="nav__made" href="https://ohmy.se" target="_blank" rel="noopener">Skapad av Oh My</a>
        </div>
      </div>
    </div>
  </div>
</nav>
