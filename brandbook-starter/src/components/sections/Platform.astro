---
import SectionHero from '../SectionHero.astro';
import type { PlatformBlock } from '../../content/profile';
interface Props { platform: PlatformBlock[]; }
const { platform } = Astro.props;
---
<section class="section sect" id="positionering">
  <SectionHero id="positionering" />
  <div class="sect__body">
  <div class="wrap">
    <div class="platform">
      {platform.map((b) => (
        <div class="platform__block" data-reveal>
          <h3 class="platform__title">{b.title}</h3>
          <p class="platform__body">{b.body}</p>
        </div>
      ))}
    </div>
  </div>
</div>
</section>
