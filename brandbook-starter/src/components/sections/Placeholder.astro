---
/* A template section with no content yet: numbered heading + what belongs here.
   Rendered for any section that isn't filled (hide them all per client with
   `hideEmpty` in profile.ts). */
import SectionHero from '../SectionHero.astro';
import { t } from '../../lib/strings';
import { sectionById } from '../../content/categories';
interface Props { id: string; }
const { id } = Astro.props;
const def = sectionById.get(id);
---
<section class="section sect section--empty" id={id}>
  <SectionHero id={id} />
  <div class="sect__body">
  <div class="wrap">
    <div class="placeholder" data-reveal>
      <span class="placeholder__tag">{t.placeholder.tag}</span>
      {def?.missing && <p class="placeholder__lead">{t.empty.lead} {def.missing}.</p>}
      <p class="placeholder__about">{def?.why ?? 'Sektionen ingår i mallen men har inget innehåll ännu.'}</p>
    </div>
  </div>
</div>
</section>
