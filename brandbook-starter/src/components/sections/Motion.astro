---
import SectionHero from '../SectionHero.astro';
import { t } from '../../lib/strings';
import type { MotionItem } from '../../content/profile';
interface Props { motion: MotionItem[]; }
const { motion } = Astro.props;
---
<section class="section sect" id="motion">
  <SectionHero id="motion" lede="Rörligt material spelar direkt i sidan — fördelen mot en statisk PDF." />
  <div class="sect__body">
  <div class="wrap">
  </div>

  <div class="motion bleedgrid">
    {motion.map((m) => (
      <figure data-reveal>
        <div class="motion__frame">
          <video src={m.src} poster={m.poster} controls preload="metadata" playsinline></video>
        </div>
        <p class="motion__cap"><strong>{m.title}</strong>{m.note && <> — {m.note}</>}
          <br /><a class="btn btn--sm no-print" href={m.src} download style="margin-top:0.5rem">{t.actions.download}</a>
        </p>
      </figure>
    ))}
  </div>
</div>
</section>
