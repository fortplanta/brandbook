---
/**
 * LogotypesSection — "sticky visual, scrolling captions", matching the Dropbox
 * brand site: NATIVE mandatory scroll-snap on the page pins each 100svh section,
 * only the logo is sticky, and the logo morphs per section.
 *
 * TEMPLATE / per-client logo animation with a fallback chain:
 *   Rive  ─▶  Lottie  ─▶  SVG crossfade
 * Pass `animation` when a client has a .riv / .json (Dropbox uses Rive). When
 * they don't — or the file/runtime fails — it degrades to the SVG variant stack
 * that is ALWAYS rendered. The base template pulls in no animation libraries;
 * the runtime is fetched lazily only when `animation` is set. See
 * logotypes-interaction.ts.
 *
 *   // Rive example
 *   <LogotypesSection animation={{
 *     type: 'rive', src: '/assets/acme-logo.riv',
 *     stateMachine: 'Logo', numberInput: 'section',   // set to the section index
 *   }} />
 *   // Lottie example
 *   <LogotypesSection animation={{
 *     type: 'lottie', src: '/assets/acme-logo.json',
 *     segments: [[0,30],[30,60],[60,90],[90,120],[120,150],[150,180]],
 *   }} />
 */

export interface LogoAnimation {
  type: 'rive' | 'lottie';
  src: string;
  runtimeUrl?: string;
  artboard?: string; stateMachine?: string; numberInput?: string; triggers?: string[];
  renderer?: 'svg' | 'canvas'; segments?: [number, number][];
}
import type { Logo } from '../../content/profile';

interface LogoFrame { id: string; title: string; body: string; kind: 'image' | 'video' | 'mono' | 'inverse' | 'clearspace'; src: string; dark?: boolean; }
interface Props { logos: Logo[]; animation?: LogoAnimation; }
const { logos = [], animation } = Astro.props;

/* The frames come from the client's own logos (profile / CMS):
     1. one frame per logo — its name and note (generic names like "Logotyp",
        from lazily named files, fall back to titles by position)
     2. guideline frames generated from the primary logo, when it's a vector or
        a known-transparent image (can be recoloured with a filter): Monokrom, Negativ
        (unless the client has its own on-dark logo), Frizon
     3. a logo animation (a video filed as a logo) → "I rörelse"               */
const isVideo = (src = '') => /\.(mp4|webm)(\?|$)/i.test(src);
// only a vector or a KNOWN transparent image can be recoloured by filter —
// an opaque PNG (a logo on a coloured card) would turn into a black rectangle
const recolourable = (l: Logo) => /\.svg(\?|$)/i.test(l.image) || l.transparent === true;
const GENERIC = /^(logo|logotyp|logotype|logga)$/i;
const POSITION_TITLES = ['Primär logotyp', 'Sekundär logotyp', 'Tredje variant', 'Fjärde variant'];
const POSITION_BODIES = [
  'Förstahandsval i all kommunikation. Ändra aldrig proportioner eller färg.',
  'För format där den primära logotypen inte får plats eller inte fungerar.',
];

const stills = logos.filter((l) => l.image && !isVideo(l.image));
const motion = logos.filter((l) => isVideo(l.image));
const primary = stills[0];
const frames: LogoFrame[] = stills.map((l, i) => ({
  id: `logo-${i}`, kind: 'image', src: l.image, dark: l.onDark,
  title: l.name && !GENERIC.test(l.name.trim()) ? l.name : (POSITION_TITLES[i] ?? `Variant ${i + 1}`),
  body: l.note || POSITION_BODIES[i] || '',
}));
if (primary && recolourable(primary)) {
  frames.push({ id: 'mono', kind: 'mono', src: primary.image, title: 'Monokrom', body: 'En färg. För tryck i en pantone, gravyr, eller när underlaget inte tillåter full färg.' });
  if (!stills.some((l) => l.onDark)) frames.push({ id: 'inverse', kind: 'inverse', src: primary.image, dark: true, title: 'Negativ', body: 'På mörk eller färgstark bakgrund. Använd den negativa versionen — aldrig den positiva urklippt.' });
}
if (primary) frames.push({ id: 'clearspace', kind: 'clearspace', src: primary.image, title: 'Frizon', body: 'Håll fri yta runt logotypen — minst symbolens höjd på alla sidor. Låt den andas.' });
motion.forEach((l, i) => frames.push({
  id: `motion-${i}`, kind: 'video', src: l.image,
  title: l.name && !GENERIC.test(l.name.trim()) ? l.name : 'I rörelse',
  body: l.note || 'Så rör sig logotypen — i intron till filmer, på skärmar och i digitala kanaler.',
}));

const pad = (n: number) => String(n).padStart(2, '0');
const total = pad(frames.length);
---
<section class="lt-chapter" id="logos" aria-label="Logotyper" data-lt-chapter>
  <slot name="hero" /><!-- the shared section hero (SectionHero), passed in from the page -->
  <div class="lt-grid">
    <!-- LEFT — REAL scrolling frames -->
    <div class="lt-frames">
      {frames.map((f, i) => (
        <article class:list={['lt-frame', i === 0 && 'is-current']} data-lt-frame data-index={i} data-variant={f.id}>
          <div class="lt-frame__inner">
            <span class="lt-frame__idx">{pad(i + 1)} <span>/ {total}</span></span>
            <h2 class="lt-frame__title">{f.title}</h2>
            {f.body && <p class="lt-frame__body">{f.body}</p>}
          </div>
        </article>
      ))}
    </div>

    <!-- RIGHT — pinned logo, switches to the active frame's variant -->
    <div class="lt-logo-rail" aria-hidden="true">
      <div class="lt-logo-sticky">
        <div class="lt-logo-media" data-lt-logo-media>
          {/* Rich animation mounts — rendered only when a client supplies one.
              The driver reveals the right one and hides the fallback stack; on
              any failure it stays hidden and the stack shows. */}
          {animation?.type === 'rive' && <canvas class="lt-rive" data-lt-rive></canvas>}
          {animation?.type === 'lottie' && <div class="lt-lottie" data-lt-lottie></div>}
          {animation && <script type="application/json" data-lt-anim set:html={JSON.stringify(animation)} />}

          <!-- Always-present stack: one visual per frame, from the client's files -->
          <div class="lt-logo-stack" data-lt-fallback>
          {frames.map((f, i) => (
            <div class:list={['lt-logo', i === 0 && 'is-active', `lt-logo--${f.kind}`, f.dark && 'lt-logo--dark']} data-variant={f.id}>
              {f.kind === 'video'
                ? <video class="lt-img" src={f.src} autoplay muted loop playsinline preload="metadata"></video>
                : f.kind === 'clearspace'
                  ? <span class="lt-clear"><img class="lt-img" src={f.src} alt="" loading="lazy" /></span>
                  : <img class="lt-img" src={f.src} alt="" loading="lazy" />}
            </div>
          ))}
          </div>
        </div>
        <div class="lt-ticks">
          {frames.map((_, i) => (<span class:list={['lt-tick', i === 0 && 'is-active']} data-tick={i}></span>))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initLogotypes } from '../../scripts/logotypes-interaction';
  initLogotypes();
</script>

<style>
  .lt-chapter, .lt-chapter *, .lt-chapter *::before, .lt-chapter *::after { box-sizing: border-box; }

  .lt-chapter {
    /* Inherit the book's per-client palette; fall back to standalone values. */
    --lt-brand: var(--color-brand, #0b78de);
    --lt-ink: var(--color-ink, #111113);
    --lt-muted: var(--color-muted, #9a9aa2);
    --lt-paper: var(--color-paper, #ffffff);
    --lt-sink: var(--color-sink, #f4f4f2);
    --lt-font: var(--font-ui, "Inter", system-ui, sans-serif);
    position: relative; background: var(--lt-paper);
  }
  /* align-items:stretch (default) is REQUIRED: it makes the right column as tall
     as the scrolling frames, giving the sticky logo room to pin across them all.
     With align-items:start the rail collapses to 100svh and the logo scrolls off. */
  .lt-grid { display: grid; grid-template-columns: 1fr minmax(300px, 44%); align-items: stretch; }

  /* LEFT — real scrolling content (this is what makes it NOT a slider) */
  .lt-frames { grid-column: 1; }
  /* NATIVE snap, exactly like the Dropbox brand site: mandatory snap lives on
     <html> (the page scroll — see the demo page), each section is one snap
     target. No scroll-snap-stop, so multi-section flicks are allowed (Dropbox
     lets you fling through two at once). */
  .lt-frame {
    position: relative;
    min-height: 100svh; scroll-snap-align: start;
    display: grid; align-items: center;
    padding: clamp(2rem,8vh,6rem) clamp(1.5rem,5vw,5rem);
    border-bottom: 1px solid color-mix(in oklab, var(--lt-ink) 5%, transparent);
  }
  /* Dropbox's left vertical rule per section */
  .lt-frame::before {
    content: ""; position: absolute; left: clamp(1.5rem,5vw,5rem); top: 22%; bottom: 22%;
    width: 1px; background: color-mix(in oklab, var(--lt-ink) 14%, transparent);
  }
  .lt-frame__inner { max-width: 34rem; padding-left: clamp(1.25rem, 3vw, 2.5rem); }
  .lt-frame__idx { font-family: ui-monospace, monospace; font-size: 0.8rem; letter-spacing: 0.14em; color: var(--lt-muted); display: block; margin-bottom: 1.25rem; }
  .lt-frame__idx span { opacity: 0.6; }
  .lt-frame__title { font-size: clamp(2rem, 5.5vw, 3.6rem); line-height: 1.02; letter-spacing: -0.03em; margin: 0; color: var(--lt-ink); }
  .lt-frame__body { margin: 1.25rem 0 0; font-size: 1.1rem; line-height: 1.55; color: color-mix(in oklab, var(--lt-ink) 68%, var(--lt-paper)); max-width: 42ch; }

  /* "activate a transition" — content settles as its frame becomes current */
  @media (prefers-reduced-motion: no-preference) {
    .lt-frame__inner > * { opacity: 0.28; transform: translateY(0.6rem); transition: opacity 0.3s ease, transform 0.42s cubic-bezier(0.16,1,0.3,1); }
    .lt-frame.is-current .lt-frame__idx   { opacity: 1; transform: none; transition-delay: 0.01s; }
    .lt-frame.is-current .lt-frame__title { opacity: 1; transform: none; transition-delay: 0.05s; }
    .lt-frame.is-current .lt-frame__body  { opacity: 1; transform: none; transition-delay: 0.09s; }
  }

  /* RIGHT — pinned logo; the ONLY pinned thing */
  .lt-logo-rail { grid-column: 2; }
  .lt-logo-sticky {
    position: sticky; top: 0; height: 100svh; overflow: hidden;
    display: grid; place-items: center; padding: clamp(2rem,6vw,5rem);
    background: var(--lt-sink); border-left: 1px solid color-mix(in oklab, var(--lt-ink) 8%, transparent);
  }
  /* media container stacks the rich mount + the SVG fallback in one cell */
  .lt-logo-media { position: relative; width: 100%; max-width: 26rem; aspect-ratio: 4 / 3; display: grid; place-items: center; }
  .lt-rive, .lt-lottie { grid-area: 1 / 1; width: 100%; height: 100%; display: none; }
  /* the driver sets data-driver once it knows which one won */
  [data-lt-logo-media][data-driver="rive"]   .lt-rive   { display: block; }
  [data-lt-logo-media][data-driver="lottie"] .lt-lottie { display: block; }
  [data-lt-logo-media][data-driver="rive"]   [data-lt-fallback],
  [data-lt-logo-media][data-driver="lottie"] [data-lt-fallback] { display: none; }
  .lt-logo-stack { grid-area: 1 / 1; position: relative; width: 100%; height: 100%; display: grid; place-items: center; }
  .lt-logo {
    grid-area: 1 / 1; width: 100%; height: 100%; display: grid; place-items: center;
    opacity: 0; transform: scale(0.94); pointer-events: none;
    transition: opacity 200ms ease, transform 260ms cubic-bezier(0.16,1,0.3,1); will-change: opacity, transform;
  }
  .lt-logo.is-active { opacity: 1; transform: none; }
  .lt-img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .lt-logo--dark { background: var(--lt-ink); border-radius: 18px; padding: 12%; }
  /* generated variants: recoloured with filters (vector / transparent logos only) */
  .lt-logo--mono .lt-img { filter: grayscale(1) brightness(0); }
  .lt-logo--inverse .lt-img { filter: grayscale(1) brightness(0) invert(1); }
  .lt-logo--video .lt-img { object-fit: cover; border-radius: 12px; }
  .lt-clear { display: grid; place-items: center; width: 86%; height: 78%; padding: 14%; border: 1.5px dashed var(--lt-muted); }

  .lt-ticks { position: absolute; right: clamp(1rem,3vw,2rem); top: 50%; transform: translateY(-50%); display: flex; flex-direction: column; gap: 0.6rem; }
  .lt-tick { width: 7px; height: 7px; border-radius: 50%; background: var(--lt-ink); opacity: 0.22; transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.16,1,0.3,1); }
  .lt-tick.is-active { opacity: 1; transform: scale(1.5); }

  @media (prefers-reduced-motion: reduce) { .lt-logo, .lt-tick { transition: none; } }
  @media (max-width: 820px) {
    .lt-grid { grid-template-columns: 1fr; }
    .lt-logo-rail { grid-column: 1; grid-row: 1; }         /* logo pins as a top bar */
    .lt-frames { grid-column: 1; grid-row: 2; }
    .lt-logo-sticky { height: 34svh; border-left: 0; border-bottom: 1px solid color-mix(in oklab, var(--lt-ink) 8%, transparent); }
    .lt-frame { align-items: start; }
    .lt-ticks { top: auto; bottom: 0.6rem; right: 50%; transform: translateX(50%); flex-direction: row; }
  }
</style>
