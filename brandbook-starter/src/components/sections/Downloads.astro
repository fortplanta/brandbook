---
import { t } from '../../lib/strings';
import type { DownloadGroup } from '../../content/profile';
interface Props { downloads: DownloadGroup[]; downloadAllHref?: string; }
const { downloads, downloadAllHref } = Astro.props;
---
<section class="section" id="downloads">
  <div class="wrap">
  <div class="section__head">
    <h2 class="section__title" data-reveal>{t.sections.downloads}</h2>
    {downloadAllHref && (
      <p style="margin-top:1rem"><a class="btn btn--solid" href={downloadAllHref} download>{t.actions.downloadAll}</a></p>
    )}
  </div>

  {downloads.map((g) => (
    <div class="dl-group" data-reveal>
      <p class="dl-group__title">{g.group}</p>
      {g.items.map((item) => (
        <div class="dl-row">
          <span class="dl-row__label">
            {item.label}
            {item.size && <span class="dl-row__size">{item.size}</span>}
          </span>
          <a class="btn btn--sm" href={item.href} download>{t.actions.download}</a>
        </div>
      ))}
    </div>
  ))}
  </div>
</section>
