---
import { t } from '../../lib/strings';
import type { Color } from '../../content/profile';
import type { Typeface } from '../../content/profile';
import { buildTokens } from '../../lib/tokens';
import { swatchContrast, paperReference, fmtRatio } from '../../lib/contrast';
interface Props { colors: Color[]; typography?: Typeface[]; }
const { colors, typography = [] } = Astro.props;

const paper = paperReference(colors);
const contrast = colors.map((c) => swatchContrast(c.hex, paper));
const tokens = buildTokens(colors, typography);

const ratingLabel = (r: string) => (r === 'low' ? t.contrast.fail : r);
---
<section class="section" id="colors">
  <div class="wrap">
  <div class="section__head">
    <h2 class="section__title" data-reveal>{t.sections.colors}</h2>
    <p class="section__note">Klicka på ett fält för att kopiera HEX. Kontrasten visas mot papper (WCAG).</p>
  </div>

  <div class="colors">
    {colors.map((c, i) => (
      <button class="swatch" data-copy={c.hex} type="button" data-reveal aria-label={`Kopiera ${c.name}, ${c.hex}`}>
        <span class="swatch__chip" style={`background:${c.hex}`}></span>
        <span class="swatch__body">
          <span class="swatch__copy" aria-hidden="true">
            <svg class="i-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <svg class="i-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          </span>
          <span class="swatch__name">{c.name}{c.role && <span class="swatch__role">{c.role}</span>}</span>
          <span class="swatch__spec">
            <span data-copy-label>{c.hex}</span><br />
            {c.rgb && <>RGB {c.rgb}<br /></>}
            {c.cmyk && <>CMYK {c.cmyk}<br /></>}
            {c.pantone && <>PMS {c.pantone}</>}
          </span>
          <span class="swatch__contrast" aria-label={`Kontrast som text på papper ${fmtRatio(contrast[i].onPaper.ratio)}, ${ratingLabel(contrast[i].onPaper.rating)}. Läsbar text på fältet: ${contrast[i].bestText.color === 'dark' ? t.contrast.dark : t.contrast.light}, ${ratingLabel(contrast[i].bestText.rating)}.`}>
            <span class:list={['cbadge', `cbadge--${contrast[i].onPaper.rating}`]} title={`${t.contrast.onPaper} — ${fmtRatio(contrast[i].onPaper.ratio)}`}>
              <span class="cbadge__k">{ratingLabel(contrast[i].onPaper.rating)}</span> {t.contrast.onPaper}
            </span>
            <span class:list={['cbadge', `cbadge--${contrast[i].bestText.rating}`]} title={`${t.contrast.bestText} — ${fmtRatio(contrast[i].bestText.ratio)}`}>
              <span class="cbadge__swatch" style={`background:${c.hex};color:${contrast[i].bestText.color === 'dark' ? '#111113' : '#ffffff'}`}>Aa</span>
              {contrast[i].bestText.color === 'dark' ? t.contrast.dark : t.contrast.light} {t.contrast.bestText}
            </span>
          </span>
        </span>
      </button>
    ))}
  </div>

  <div class="tokens" data-tokens>
    <div class="tokens__head">
      <span class="tokens__label">{t.tokens.label}</span>
      <span class="tokens__hint">{t.tokens.hint}</span>
    </div>
    <div class="tokens__btns">
      <button class="btn btn--sm" type="button" data-copy-text={tokens.css} data-copy-done={t.tokens.copied}>CSS</button>
      <button class="btn btn--sm" type="button" data-copy-text={tokens.json} data-copy-done={t.tokens.copied}>JSON</button>
      <button class="btn btn--sm" type="button" data-copy-text={tokens.tailwind} data-copy-done={t.tokens.copied}>Tailwind</button>
    </div>
  </div>
  </div>
</section>
