---
import SectionHero from '../SectionHero.astro';
import type { ImageItem } from '../../content/profile';
interface Props { note?: string; images: ImageItem[]; }
const { note, images } = Astro.props;
---
<section class="section sect" id="imagery">
  <SectionHero id="imagery" lede={note} media={images[0] ? { src: images[0].src, alt: images[0].caption } : undefined} />
  <div class="sect__body">
  <div class="wrap">
  </div>

  <div class="imagery bleedgrid">
    {images.map((img) => (
      <figure data-reveal>
        <div class="imagery__frame"><img src={img.src} alt={img.caption ?? ''} loading="lazy" /></div>
        {img.caption && <figcaption>{img.caption}</figcaption>}
      </figure>
    ))}
  </div>
</div>
</section>
